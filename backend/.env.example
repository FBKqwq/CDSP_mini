CDSP_APP_NAME=CDSP Mini API
CDSP_ENVIRONMENT=development
CDSP_API_V1_PREFIX=/api/v1
# 逗号分隔。微信小程序不依赖 CORS；仅在 H5 联调时按需填写。
CDSP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL 数据源（仅 app_user / auth_session / patient_profile / medical_history 四张表）
CMEAGENT_DB_HOST=172.18.1.120
CMEAGENT_DB_PORT=3306
CMEAGENT_DB_NAME=cdsp_mini
CMEAGENT_DB_USER=root
CMEAGENT_DB_PASSWORD=your_password

# 认证
CDSP_AUTH_SESSION_TTL_HOURS=8
CDSP_AUTH_LOCK_THRESHOLD=5
CDSP_AUTH_LOCK_MINUTES=15
